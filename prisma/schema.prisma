generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                String         @id @default(cuid())
  sku               String         @unique
  slug              String         @unique
  name              String
  category          String         // RAYON_HANDLOOM | FULL_COTTON | RAYON_PUNE | COTTON_PUNE | EMBROIDERED | IMPORTED
  badge             String         // HANDLOOM | IMPORTED
  fabric            String
  weave             String
  origin            String
  length            String         @default("Approx. 5.5 m body + blouse piece")
  colours           String         // JSON string array
  occasions         String         // JSON string array
  shortDesc         String
  longDesc          String
  care              String
  priceLkr          Int
  compareAtLkr      Int?
  costLkr           Int
  stock             Int            @default(0)
  lowStockThreshold Int            @default(3)
  status            String         @default("ACTIVE") // ACTIVE | DRAFT | HIDDEN | SOLD_OUT
  isPreOrder        Boolean        @default(false)
  isNewArrival      Boolean        @default(false)
  publishAt         DateTime?
  deletedAt         DateTime?
  seoTitle          String?
  seoDesc           String?
  images            ProductImage[]
  orderItems        OrderItem[]
  events            Event[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([category])
  @@index([status])
  @@index([deletedAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?
  address       String?
  district      String?
  optInWhatsApp Boolean  @default(false)
  optInEmail    Boolean  @default(false)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  status            String      @default("NEW") // NEW | PAYMENT_PENDING | PAID | PACKED | DISPATCHED | DELIVERED | CANCELLED | RETURNED
  paymentMethod     String      // BANK_TRANSFER | COD | CARD_LINK
  slipUrl           String?
  slipStatus        String?     // PENDING | APPROVED | REJECTED
  subtotalLkr       Int
  deliveryFeeLkr    Int         @default(0)
  bundleDiscountLkr Int         @default(0)
  totalLkr          Int
  shippingName      String
  shippingPhone     String
  shippingAddress   String
  shippingDistrict  String
  courier           String?
  trackingNumber    String?
  internalNotes     String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  sku         String
  unitPriceLkr Int
  quantity    Int

  @@index([orderId])
  @@index([productId])
}

model Event {
  id        String   @id @default(cuid())
  type      String   // PAGE_VIEW | PRODUCT_VIEW | ADD_TO_CART | CHECKOUT_START | ORDER_PAID | WHATSAPP_CLICK | WISHLIST_ADD
  path      String
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  source    String?  // direct | facebook | instagram | tiktok | whatsapp | search
  device    String?  // mobile | desktop | tablet
  sessionId String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([productId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("STAFF") // OWNER | STAFF
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Setting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  detailsJson String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
